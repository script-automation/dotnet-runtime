FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS base

ENV ASPNETCORE_HTTP_PORTS=
ENV ASPNETCORE_HTTPS_PORTS=8443
ENV ASPNETCORE_Kestrel__Certificates__Default__Path=/https/server.crt
ENV ASPNETCORE_Kestrel__Certificates__Default__KeyPath=/https/server.key

RUN mkdir -p /https
WORKDIR /https

COPY --chown=$APP_UID:$APP_UID server.crt .
COPY --chown=$APP_UID:$APP_UID server.key .

RUN chmod 644 server.crt
RUN chmod 600 server.key

USER root
RUN mkdir /data && chown $APP_UID /data

WORKDIR /app
RUN mkdir obj && chown $APP_UID obj
RUN mkdir wwwroot2 && chown $APP_UID wwwroot2

USER $APP_UID

RUN dotnet --info

EXPOSE $ASPNETCORE_HTTPS_PORTS